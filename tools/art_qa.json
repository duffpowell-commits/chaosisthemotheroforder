        "assets/ui/woodcut/poster_movement_unbroken.png"
      ],
      "size": {
        "w": 768,
        "h": 1024
      },
      "palette": {
        "blue_max": 0.02
      }
    },
    {
      "name": "woodcut stamp (red, no blue)",
