{
  "_doc": "Rules for tools/art_qa.py. Palette limits are % of opaque pixels. Groups are matched in order; the first match wins. Put approved one-off exceptions in 'exceptions' with a reason instead of loosening a group.",
  "ignore": [
    "*_lettered.png",
    "assets/characters/rigged/*",
    "assets/characters/duff_front.png"
  ],
  "palette_defs": {
    "red": {
      "hue": [
        345,
        12
      ],
      "s_min": 0.5,
      "v_min": 0.35
    },
    "maroon": {
      "hue": [
        345,
        12
      ],
      "s_min": 0.35,
      "v_min": 0.12,
      "v_max": 0.35
    },
    "blue": {
      "hue": [
        195,
        250
      ],
      "s_min": 0.35,
      "v_min": 0.25
    }
  },
  "ocr": {
    "backgrounds": [
      [
        233,
        224,
        204
      ],
      [
        200,
        200,
        200
      ]
    ],
    "scales": [
      0.5,
      1.0,
      2.0
    ],
    "psm": 11,
    "min_len": 3,
    "min_conf": 85,
    "confirm_runs": 2,
    "single_conf": 95,
    "allow_tokens": [
      "0417"
    ]
  },
  "groups": [
    {
      "name": "sprite display copy (128 tall)",
      "globs": [
        "assets/characters/*/display/*.png"
      ],
      "size": {
        "h": 128
      },
      "mode": [
        "RGBA"
      ],
      "sprite": true,
      "edge_alpha_max": 200,
      "min_transparent": 0.3,
      "ocr": false
    },
    {
      "name": "regime sprite (never red)",
      "globs": [
        "assets/characters/guard/*.png",
        "assets/characters/guard_defector/*.png"
      ],
      "size": {
        "h": 1024
      },
      "mode": [
        "RGBA"
      ],
      "sprite": true,
      "edge_alpha_max": 16,
      "palette": {
        "red_max": 0.05,
        "maroon_max": 0.1
      }
    },
    {
      "name": "civilian sprite (olive/brown, no red, no blue)",
      "globs": [
        "assets/characters/civilian_*/*.png"
      ],
      "size": {
        "h": 1024
      },
      "mode": [
        "RGBA"
      ],
      "sprite": true,
      "edge_alpha_max": 16,
      "palette": {
        "red_max": 0.05,
        "maroon_max": 0.25,
        "blue_max": 0.1
      }
    },
    {
      "name": "movement sprite (one small red item)",
      "globs": [
        "assets/characters/duff/*.png",
        "assets/characters/mara/*.png",
        "assets/characters/kesh/*.png",
        "assets/characters/teodor/*.png",
        "assets/characters/operative_*/*.png",
        "assets/characters/visor_operative/*.png"
      ],
      "size": {
        "h": 1024
      },
      "mode": [
        "RGBA"
      ],
      "sprite": true,
      "edge_alpha_max": 16,
      "palette": {
        "red_max": 5.0,
        "maroon_max": 4.0
      }
    },
    {
      "name": "portrait",
      "globs": [
        "assets/portraits/*.png"
      ],
      "size": {
        "w": 768,
        "h": 768
      }
    },
    {
      "name": "painted scene (red subtle, no maroon extras)",
      "globs": [
        "assets/art/stills/*.png",
        "assets/art/endings/*.png",
        "assets/ui/backdrop_*_painted.png",
        "assets/ui/backdrop_signal_box.png"
      ],
      "size": {
        "w": 1280,
        "h": 720
      },
      "palette": {
        "red_max": 2.0,
        "maroon_max": 1.5
      }
    },
    {
      "name": "regime woodcut (blue-grey, no red)",
      "globs": [
        "assets/ui/woodcut/poster_regime_continuity.png",
        "assets/ui/woodcut/report_frame_cn24.png",
        "assets/ui/woodcut/opening_dormitory_raid.png"
      ],
      "palette": {
        "red_max": 0.02,
        "maroon_max": 0.02
      }
    },
    {
      "name": "movement woodcut 16:9 (red, no blue)",
      "globs": [
        "assets/ui/woodcut/title.png",
        "assets/ui/woodcut/report_frame_unbroken.png"
      ],
      "size": {
        "w": 1280,
        "h": 720
      },
      "palette": {
        "blue_max": 0.02
      }
    },
    {
      "name": "movement poster (red, no blue)",
