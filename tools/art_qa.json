        "assets/ui/woodcut/stamp_*.png"
      ],
      "size": {
        "w": 1024,
        "h": 1024
      },
      "palette": {
        "blue_max": 0.02
      }
    },
    {
      "name": "woodcut icon display (128 sq)",
      "globs": [
        "assets/ui/woodcut/icons/display/*.png"
      ],
      "size": {
        "w": 128,
        "h": 128
      },
      "palette": {
        "blue_max": 0.05
      },
      "ocr": false
    },
    {
      "name": "woodcut icon (red, no blue)",
      "globs": [
        "assets/ui/woodcut/icons/*.png"
      ],
      "size": {
        "w": 1024,
        "h": 1024
      },
      "palette": {
        "blue_max": 0.02
      }
    },
    {
      "name": "itch cover",
      "globs": [
        "assets/art/itch/cover_630x500.png"
      ],
      "size": {
        "w": 630,
        "h": 500
      },
      "palette": {
        "blue_max": 0.02
      }
    },
    {
      "name": "itch banner",
      "globs": [
        "assets/art/itch/banner_960x300.png"
      ],
      "size": {
        "w": 960,
        "h": 300
      },
      "palette": {
        "blue_max": 0.02
      }
    },
    {
      "name": "style anchor crop",
      "globs": [
        "assets/art/source/style_anchor_*.png"
      ],
      "palette": {
        "red_max": 0.05
      }
    }
  ],
  "exceptions": {
    "assets/art/endings/district_turns.png": {
      "palette": {
        "maroon_max": 3.0
      },
      "reason": "Approved Nov 14: red tablecloth in shadow plus a few tiny maroon-ish background figures (logged in art-notes section 12)."
    },
    "assets/characters/operative_a/operative_a_back.png": {
      "palette": {
        "maroon_max": 7.5
      },
      "reason": "Approved: the long red knit scarf hangs down her back and its shadow side reads as maroon; it is her one movement item."
    },
    "assets/characters/duff/duff_front.png": {
      "skip": [
        "edge"
      ],
      "reason": "Approved sprite: boot soles sit on the bottom edge of the source image, so the cut has no bottom padding. Boots are complete."
    },
    "assets/characters/duff/display/duff_front.png": {
      "skip": [
        "edge"
      ],
      "reason": "Display copy of duff_front (soles on the bottom edge)."
    },
    "assets/characters/civilian_c/civilian_c_front.png": {
